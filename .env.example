# SearXNG (self-hosted metasearch — run: docker compose up -d)
# Leave as-is for local Docker setup; change host if running remotely
SEARXNG_URL=http://localhost:8080

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LLM output token limits (num_predict / max_tokens)
OLLAMA_NUM_PREDICT_STREAM=4096
OLLAMA_NUM_PREDICT_SYNTH=8192
OLLAMA_NUM_PREDICT_NONSTREAM=4096

# OpenRouter (OpenAI-compatible API — https://openrouter.ai)
# API key: ~/.openclaw/agents/main/agent/auth-profiles.json (openrouter:default.key)
OMNIROUTE_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_MODEL=openrouter/free
OMNIROUTE_API_KEY=your_openrouter_api_key_here

# Auto scheduled runs (no UI) — local | omniroute
LLM_DEFAULT_PROVIDER=omniroute

# Serper.dev (Google Search API — https://serper.dev, 2,500 free queries)
# Used as secondary backend when SearXNG returns 0 results
SERPER_API_KEY=your_serper_api_key_here

# Kakao Talk API Configuration
# 1. Go to https://developers.kakao.com and create an app
# 2. Enable "카카오톡 메시지" in your app settings
# 3. Add redirect URI: http://localhost:5173/api/auto/kakao/callback
# 4. Copy your REST API Key below

KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Telegram Bot (optional; only for "연동됨" status - actual send uses UI settings)
# 1. Create a bot via @BotFather, get the token
# 2. Get your Chat ID: message @userinfobot /start; add bot + chat in Auto Telegram settings

# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
